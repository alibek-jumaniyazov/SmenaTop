# Generate unique local secrets with: node scripts/setup-env.mjs
# Do not use the local adapters or local credentials in production.
APP_ENV=local
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins, overriding WEB_ORIGIN.
# CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://smenatop:GENERATE_ME@127.0.0.1:55432/smenatop?schema=public
POSTGRES_USER=smenatop
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=smenatop
REDIS_URL=redis://127.0.0.1:56379
# QUEUE_NAMESPACE=smenatop-local
LOCAL_DEV_KEY=GENERATE_ME
OTP_PEPPER=GENERATE_ME
FILE_SIGNING_SECRET=GENERATE_ME
MFA_ENCRYPTION_KEY=GENERATE_ME
DEV_TOOLS_ENABLED=true
SMS_PROVIDER=local
LOCAL_MOCK_PAYMENTS=true
MOCK_PAYMENT_SECRET=GENERATE_ME
# Private local files adapter. Compose can use MinIO via S3.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.local/private-files
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=smenatop-private
S3_ACCESS_KEY=GENERATE_ME
S3_SECRET_KEY=GENERATE_ME
MINIO_ROOT_USER=GENERATE_ME
MINIO_ROOT_PASSWORD=GENERATE_ME
# Set only on server, after merchant/SMS onboarding; never prefix secrets with VITE_.
PAYME_MERCHANT_ID=
PAYME_ENABLED=false
PAYME_ENVIRONMENT=SANDBOX
PAYME_LOGIN=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
BANK_ACCOUNT_REFERENCE=
BANK_BENEFICIARY=
SMS_API_URL=
SMS_API_TOKEN=
# Production scanner; no host means local uploads stay quarantined.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional supported S3 server-side encryption value.
# S3_SERVER_SIDE_ENCRYPTION=AES256
# Public build configuration only.
VITE_APP_ENV=local
# Separate real PostgreSQL database for tests, never the application database.
TEST_DATABASE_URL=postgresql://smenatop:GENERATE_ME@127.0.0.1:55432/smenatop_test?schema=public

